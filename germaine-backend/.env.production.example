# PRODUCTION environment template for germaine-backend.
#
# Copy this to a real .env in the production application root (or enter
# these as cPanel "Environment Variables" for the Python App — either
# mechanism works, app/__init__.py's load_dotenv() picks up a .env file
# if present, and real process environment variables always take
# precedence over it either way).
#
# NEVER commit the filled-in version of this file. NEVER paste real
# values for these into chat, a support ticket, or anywhere else public.

FLASK_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be long, random, and different from any value ever used in
# development/testing. Rotating this invalidates every existing admin
# session (forces re-login) — safe to do, just be aware of it.
SECRET_KEY=

# Real production PostgreSQL connection string.
# Shape: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# If your host requires SSL for the DB connection, append ?sslmode=require
DATABASE_URL=

# Comma-separated list of origins allowed to call the PUBLIC "/api/..."
# endpoints cross-origin (catalogue/enquiry reads, EarnCash's namespace).
# Only needed if the frontend is served from a DIFFERENT origin than
# this API. Since build10/ (the public site + EarnCash) is deployed
# same-origin with this backend in the standard setup described in
# DEPLOYMENT.md, this can usually stay empty. If you do deploy the
# frontend on a separate subdomain, set it to that exact origin, e.g.:
#   CORS_ALLOWED_ORIGINS=https://site.germaineinstitute.ac.ke
# Never applies to /admin/ (session-cookie admin portal is same-origin
# only, always, regardless of this setting).
CORS_ALLOWED_ORIGINS=

# Optional. Minimum EarnCash withdrawal amount in KES. Defaults to 500
# if unset (see app/blueprints/earncash/withdrawal_routes.py).
EARNCASH_MIN_WITHDRAWAL_AMOUNT=500
