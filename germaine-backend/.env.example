# Copy this file to .env and fill in real values locally.
# .env is git-ignored — never commit real credentials.
# No production credentials exist anywhere in this repository.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL connection string. Not created or connected to by this
# Step 3 scaffold — only read from the environment when the app starts.
# Example shape: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/germaine_dev

# Optional (Step 7). Comma-separated list of origins allowed to call the
# PUBLIC "/api/..." catalogue/enquiry endpoints cross-origin, e.g.
# "https://www.germaineinstitute.com". Leave unset/empty if the frontend
# and this API are served from the same origin (no CORS needed) or if no
# cross-origin frontend exists yet — no CORS headers are added at all in
# that case. Never applies to /admin/ (session-cookie admin portal is
# same-origin only, always).
CORS_ALLOWED_ORIGINS=
