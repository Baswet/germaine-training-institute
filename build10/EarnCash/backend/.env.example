# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=earncash

# --- Auth ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXP_HOURS=24

# --- Business rules ---
# Fraction of a course's tuition fee paid as commission once payment is verified (0.10 = 10%)
COMMISSION_RATE=0.10
MIN_WITHDRAWAL_AMOUNT=500

# --- CORS ---
# The origin your frontend is served from (protocol + host + port)
FRONTEND_ORIGIN=http://127.0.0.1:5500
